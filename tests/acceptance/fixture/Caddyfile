https://fixture, https://collector.localhost:{$FIXTURE_PORT}, https://localhost:{$FIXTURE_PORT}, https://127.0.0.1:{$FIXTURE_PORT} {
	tls internal

	log {
		output stdout
		format json
	}

	handle /health {
		respond "healthy" 200
	}

	handle /gapmaps/amber-runtime-map.html {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang=\"en\"><head><title>Amber runtime gap map</title></head><body><h1>AMBER_GAP_MAP_FIXTURE</h1></body></html>" 200
	}

	@analytics {
		path /e/* /i/* /batch* /decide/*
	}
	handle @analytics {
		header {
			Access-Control-Allow-Headers "*"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Origin "*"
			Content-Type "application/json"
		}
		respond "{\"status\":1}" 200
	}

	respond "not found" 404
}

https://localhost:{$APP_HTTPS_PORT}, https://127.0.0.1:{$APP_HTTPS_PORT} {
	tls internal
	reverse_proxy amber:3000
}

