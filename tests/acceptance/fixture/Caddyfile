https://fixture, https://collector.localhost:{$FIXTURE_PORT}, https://localhost:{$FIXTURE_PORT}, https://127.0.0.1:{$FIXTURE_PORT} {
	tls internal

	log {
		output stdout
		format json
	}

	handle /health {
		respond "healthy" 200
	}

	handle /gapmaps/amber-runtime-map.html {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang=\"en\"><head><title>Amber runtime gap map</title></head><body><h1>AMBER_GAP_MAP_FIXTURE</h1></body></html>" 200
	}

	handle /exports/amber-library.ris {
		header Content-Type "application/x-research-info-systems; charset=utf-8"
		respond "TY  - GEN\nTI  - AMBER_RIS_FIXTURE\nER  -" 200
	}

	handle /exports/amber-library.bib {
		header Content-Type "application/x-bibtex; charset=utf-8"
		respond "AMBER_BIBTEX_FIXTURE" 200
	}

	handle /exports/amber-library.atom {
		header Content-Type "application/atom+xml; charset=utf-8"
		respond "<?xml version=\"1.0\" encoding=\"UTF-8\"?><feed xmlns=\"http://www.w3.org/2005/Atom\"><title>AMBER_ATOM_FIXTURE</title></feed>" 200
	}

	@analytics {
		path /e/* /i/* /s/* /batch* /decide/*
	}
	handle @analytics {
		header {
			Access-Control-Allow-Headers "*"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Origin "*"
			Content-Type "application/json"
		}
		respond "{\"status\":1}" 200
	}

	@posthogFlags {
		path /flags/*
	}
	handle @posthogFlags {
		header {
			Access-Control-Allow-Headers "*"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Origin "*"
			Content-Type "application/json"
		}
		respond `{
			"errorsWhileComputingFlags": false,
			"featureFlagPayloads": {},
			"featureFlags": {},
			"flags": {},
			"requestId": "runtime-acceptance"
		}` 200
	}

	@posthogConfig {
		path /array/*/config
	}
	handle @posthogConfig {
		header Access-Control-Allow-Origin "*"
		header Content-Type "application/json"
		respond `{
			"autocapture_opt_out": false,
			"captureDeadClicks": true,
			"capturePerformance": {
				"web_vitals": true
			},
			"hasFeatureFlags": false,
			"heatmaps": true,
			"isAuthenticated": false,
			"sessionRecording": {},
			"siteApps": [],
			"supportedCompression": [],
			"toolbarParams": {},
			"toolbarVersion": "toolbar"
		}` 200
	}

	respond "not found" 404
}

