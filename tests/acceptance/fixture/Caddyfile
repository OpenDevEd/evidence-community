	tls internal
	header Content-Type "text/html; charset=utf-8"
	# The page repeats the return path and the error the library sent, so a
	# browser test can carry them back instead of inventing its own.
	respond `<!doctype html><html lang="en"><head><title>OpenScholar acceptance</title></head><body><h1>OpenScholar acceptance</h1><p id="admin-return">{query.return}</p><p id="admin-error">{query.error}</p></body></html>` 200
}

