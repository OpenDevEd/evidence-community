# Settings the runtime reads from its environment. Everything else, from identity and theme to
# search and service connections, is in the library configuration document (see config/library.example.json).

# Absolute path to the runtime library configuration. Development reads config/library.local.json when empty.
LIBRARY_CONFIG_PATH=

# Optional, for the workers.
# Where the search index and publication workers keep their instance state.
SEARCH_INDEX_WORKER_INSTANCE_PATH=
PUBLICATION_WORKER_INSTANCE_PATH=
# Requests in flight and texts per request to the embedding model. A model running on a few CPU cores
# needs about 8 requests of 10 texts; unset, a remote embedder gets 128 requests of 50 texts.
SEARCH_EMBEDDER_PARALLEL_REQUESTS=
SEARCH_EMBEDDER_BATCH_TEXTS=
