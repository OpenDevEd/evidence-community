def regex_escape:
	gsub("\\\\"; "\\\\\\\\")
	| gsub("\\."; "\\\\.")
	| gsub("\\^"; "\\\\^")
	| gsub("\\$"; "\\\\$")
	| gsub("\\|"; "\\\\|")
	| gsub("\\("; "\\\\(")
	| gsub("\\)"; "\\\\)")
	| gsub("\\["; "\\\\[")
	| gsub("\\]"; "\\\\]")
	| gsub("\\{"; "\\\\{")
	| gsub("\\}"; "\\\\}")
	| gsub("\\*"; "\\\\*")
	| gsub("\\+"; "\\\\+")
	| gsub("\\?"; "\\\\?")
	| gsub("\""; "\\\"");

def selected($bots; $rule):
	($rule.remove // [] | map(ascii_downcase)) as $removed
	| ([
		$bots[]
		| select(.category as $category | ($rule.categories // []) | index($category))
		| .userAgentPatterns[]?
	] + ($rule.add // []))
	| map(select(type == "string" and length > 0))
	| map(select(test("[\\r\\n]") | not))
	| unique_by(ascii_downcase)
	| map(select(ascii_downcase as $value | $removed | index($value) | not))
	| sort_by(ascii_downcase);

(.result.bots // .bots) as $bots
| $policy[0] as $rules
| selected($bots; $rules.training) as $training
| selected($bots; $rules.blockedScraper) as $blocked_scrapers
| selected($bots; $rules.allowed) as $allowed
| [
	"# Generated from the Cloudflare Radar Bots API. Do not edit this file.",
	"map $http_user_agent $ode_training_crawler {",
	"\tdefault 0;",
	($training[] | "\t\"~*" + regex_escape + "\" 1;"),
	"}",
	"",
	"map $http_user_agent $ode_blocked_scraper {",
	"\tdefault 0;",
	($blocked_scrapers[] | "\t\"~*" + regex_escape + "\" 1;"),
	"}",
	"",
	"map $http_user_agent $ode_allowed_crawler {",
	"\tdefault 0;",
	($allowed[] | "\t\"~*" + regex_escape + "\" 1;"),
	"}",
	""
]
| .[]
