def regex_escape:
	gsub("\\\\"; "\\\\\\\\")
	| gsub("\\."; "\\\\.")
	| gsub("\\^"; "\\\\^")
	| gsub("\\$"; "\\\\$")
	| gsub("\\|"; "\\\\|")
	| gsub("\\("; "\\\\(")
	| gsub("\\)"; "\\\\)")
	| gsub("\\["; "\\\\[")
	| gsub("\\]"; "\\\\]")
	| gsub("\\{"; "\\\\{")
	| gsub("\\}"; "\\\\}")
	| gsub("\\*"; "\\\\*")
	| gsub("\\+"; "\\\\+")
	| gsub("\\?"; "\\\\?")
	| gsub("\""; "\\\"");

def usable:
	type == "string" and length > 0 and (test("[\\r\\n]") | not);

def training($bots; $rule):
	($rule.remove // [] | map(ascii_downcase)) as $removed
	| ([
		$bots[]
		| select(.category as $category | ($rule.categories // []) | index($category))
		| .userAgentPatterns[]?
	] + ($rule.add // []))
	| map(select(usable))
	| unique_by(ascii_downcase)
	| map(select(ascii_downcase as $value | $removed | index($value) | not))
	| sort_by(ascii_downcase);

# Every verified bot that is not a training crawler is allowed, plus the
# policy's additions for bots Radar misses. Each pattern carries its Radar
# category, which names the rate budget it draws from.
def allowed($bots; $rule; $training):
	($training | map(ascii_downcase)) as $blocked
	| ([
		$bots[]
		| (.category | if type == "string" and test("^[A-Z_]+$") then . else "OTHER" end) as $category
		| .userAgentPatterns[]?
		| {pattern: ., category: $category}
	] + ($rule.add // {} | to_entries | map(.key as $category | .value[] | {pattern: ., category: $category})))
	| map(select(.pattern | usable))
	| unique_by(.pattern | ascii_downcase)
	| map(select(.pattern | ascii_downcase as $value | $blocked | index($value) | not))
	| sort_by(.pattern | ascii_downcase);

(.result.bots // .bots) as $bots
| $policy[0] as $rules
| training($bots; $rules.training) as $training
| allowed($bots; $rules.allowed; $training) as $allowed
| [
	"# Generated from the Cloudflare Radar Bots API. Do not edit this file.",
	"map $http_user_agent $ode_training_crawler {",
	"\tdefault 0;",
	($training[] | "\t\"~*" + regex_escape + "\" 1;"),
	"}",
	"",
	"map $http_user_agent $ode_allowed_crawler {",
	"\tdefault \"\";",
	($allowed[] | "\t\"~*" + (.pattern | regex_escape) + "\" " + .category + ";"),
	"}",
	""
]
| .[]
