# syntax=docker/dockerfile:1.7

ARG RUNTIME_IMAGE=node:22-bookworm-slim
FROM node:22-bookworm-slim AS base

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

FROM base AS deps

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
	npm install --no-audit --no-fund

FROM base AS builder

# Build args. Two categories:
#   1. Inlined into the client bundle by Next.js (NEXT_PUBLIC_*) or read by
#      next.config.mjs for route rewrites (MEILI_INDEX).
#   2. Required at build time by Next.js 16's cacheComponents static
#      pre-render of `'use cache'` routes (DATABASE_URL_POST, MEILISEARCH_HOST,
#      MASTER_KEY). The build container reaches these via Coolify's internal
#      Docker network — see `connect_to_docker_network: true` on the app.
# Coolify must pass these as build args (Service → Env vars → Available at Build).
ARG BASE_URL
ARG DATABASE_URL_POST
ARG MASTER_KEY
ARG MEILISEARCH_HOST
ARG MEILI_INDEX
ARG NEXT_PUBLIC_ACCENT_COLOR
ARG NEXT_PUBLIC_ANTHROPIC_MODEL
ARG NEXT_PUBLIC_COLLECTION_COLOR
ARG NEXT_PUBLIC_COMING_SOON_TAG
ARG NEXT_PUBLIC_COMPANY_NAME
ARG NEXT_PUBLIC_CONTACT_EMAIL
ARG NEXT_PUBLIC_CUSTOM_FILTER_INSTITUTION
ARG NEXT_PUBLIC_DEEPSEEK_MODEL
ARG NEXT_PUBLIC_DEFAULT_EXPANDED_COLLECTIONS
ARG NEXT_PUBLIC_DEFAULT_LOCALE
ARG NEXT_PUBLIC_DEFAULT_THEME
ARG NEXT_PUBLIC_DESCRIPTION_TAG
ARG NEXT_PUBLIC_DISABLE_AUTHOR_COUNTRY
ARG NEXT_PUBLIC_DISABLE_COUNTRY
ARG NEXT_PUBLIC_DISABLE_EMBEDDINGS
ARG NEXT_PUBLIC_DISABLE_FULLTEXT
ARG NEXT_PUBLIC_DISABLE_TAGS
ARG NEXT_PUBLIC_DOI_COLOR
ARG NEXT_PUBLIC_FORCED_THEME
ARG NEXT_PUBLIC_FUNDING_PARTNER
ARG NEXT_PUBLIC_GOOGLE_GENERATIVE_AI_MODEL
ARG NEXT_PUBLIC_HIDE_TAG
ARG NEXT_PUBLIC_INSTITUTIONS_NAME
ARG NEXT_PUBLIC_INTERNAL_TAG
ARG NEXT_PUBLIC_IS_COUNTRY_LIBRARY
ARG NEXT_PUBLIC_ITEM_NOTES_DESCRIPTION
ARG NEXT_PUBLIC_LINK_COLOR
ARG NEXT_PUBLIC_LOCALE_DETECTION
ARG NEXT_PUBLIC_LOCALES_PRIORITY
ARG NEXT_PUBLIC_MISTRAL_MODEL
ARG NEXT_PUBLIC_ONLY_LOCALE
ARG NEXT_PUBLIC_OPENAI_MODEL
ARG NEXT_PUBLIC_POSTHOG_HOST
ARG NEXT_PUBLIC_POSTHOG_KEY
ARG NEXT_PUBLIC_PUBLISH_TAGS
ARG NEXT_PUBLIC_SHOW_URL_IN_CITATION
ARG NEXT_PUBLIC_STYLE
ARG NEXT_PUBLIC_TERTIARY_COLOR
ARG NEXT_PUBLIC_UTM_DURATION

ENV BASE_URL=$BASE_URL \
	DATABASE_URL_POST=$DATABASE_URL_POST \
	MASTER_KEY=$MASTER_KEY \
	MEILISEARCH_HOST=$MEILISEARCH_HOST \
	MEILI_INDEX=$MEILI_INDEX \
	NEXT_PUBLIC_ACCENT_COLOR=$NEXT_PUBLIC_ACCENT_COLOR \
	NEXT_PUBLIC_ANTHROPIC_MODEL=$NEXT_PUBLIC_ANTHROPIC_MODEL \
	NEXT_PUBLIC_COLLECTION_COLOR=$NEXT_PUBLIC_COLLECTION_COLOR \
	NEXT_PUBLIC_COMING_SOON_TAG=$NEXT_PUBLIC_COMING_SOON_TAG \
	NEXT_PUBLIC_COMPANY_NAME=$NEXT_PUBLIC_COMPANY_NAME \
	NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL \
	NEXT_PUBLIC_CUSTOM_FILTER_INSTITUTION=$NEXT_PUBLIC_CUSTOM_FILTER_INSTITUTION \
	NEXT_PUBLIC_DEEPSEEK_MODEL=$NEXT_PUBLIC_DEEPSEEK_MODEL \
	NEXT_PUBLIC_DEFAULT_EXPANDED_COLLECTIONS=$NEXT_PUBLIC_DEFAULT_EXPANDED_COLLECTIONS \
	NEXT_PUBLIC_DEFAULT_LOCALE=$NEXT_PUBLIC_DEFAULT_LOCALE \
	NEXT_PUBLIC_DEFAULT_THEME=$NEXT_PUBLIC_DEFAULT_THEME \
	NEXT_PUBLIC_DESCRIPTION_TAG=$NEXT_PUBLIC_DESCRIPTION_TAG \
	NEXT_PUBLIC_DISABLE_AUTHOR_COUNTRY=$NEXT_PUBLIC_DISABLE_AUTHOR_COUNTRY \
	NEXT_PUBLIC_DISABLE_COUNTRY=$NEXT_PUBLIC_DISABLE_COUNTRY \
	NEXT_PUBLIC_DISABLE_EMBEDDINGS=$NEXT_PUBLIC_DISABLE_EMBEDDINGS \
	NEXT_PUBLIC_DISABLE_FULLTEXT=$NEXT_PUBLIC_DISABLE_FULLTEXT \
	NEXT_PUBLIC_DISABLE_TAGS=$NEXT_PUBLIC_DISABLE_TAGS \
	NEXT_PUBLIC_DOI_COLOR=$NEXT_PUBLIC_DOI_COLOR \
	NEXT_PUBLIC_FORCED_THEME=$NEXT_PUBLIC_FORCED_THEME \
	NEXT_PUBLIC_FUNDING_PARTNER=$NEXT_PUBLIC_FUNDING_PARTNER \
	NEXT_PUBLIC_GOOGLE_GENERATIVE_AI_MODEL=$NEXT_PUBLIC_GOOGLE_GENERATIVE_AI_MODEL \
	NEXT_PUBLIC_HIDE_TAG=$NEXT_PUBLIC_HIDE_TAG \
	NEXT_PUBLIC_INSTITUTIONS_NAME=$NEXT_PUBLIC_INSTITUTIONS_NAME \
	NEXT_PUBLIC_INTERNAL_TAG=$NEXT_PUBLIC_INTERNAL_TAG \
	NEXT_PUBLIC_IS_COUNTRY_LIBRARY=$NEXT_PUBLIC_IS_COUNTRY_LIBRARY \
	NEXT_PUBLIC_ITEM_NOTES_DESCRIPTION=$NEXT_PUBLIC_ITEM_NOTES_DESCRIPTION \
	NEXT_PUBLIC_LINK_COLOR=$NEXT_PUBLIC_LINK_COLOR \
	NEXT_PUBLIC_LOCALE_DETECTION=$NEXT_PUBLIC_LOCALE_DETECTION \
	NEXT_PUBLIC_LOCALES_PRIORITY=$NEXT_PUBLIC_LOCALES_PRIORITY \
	NEXT_PUBLIC_MISTRAL_MODEL=$NEXT_PUBLIC_MISTRAL_MODEL \
	NEXT_PUBLIC_ONLY_LOCALE=$NEXT_PUBLIC_ONLY_LOCALE \
	NEXT_PUBLIC_OPENAI_MODEL=$NEXT_PUBLIC_OPENAI_MODEL \
	NEXT_PUBLIC_POSTHOG_HOST=$NEXT_PUBLIC_POSTHOG_HOST \
	NEXT_PUBLIC_POSTHOG_KEY=$NEXT_PUBLIC_POSTHOG_KEY \
	NEXT_PUBLIC_PUBLISH_TAGS=$NEXT_PUBLIC_PUBLISH_TAGS \
	NEXT_PUBLIC_SHOW_URL_IN_CITATION=$NEXT_PUBLIC_SHOW_URL_IN_CITATION \
	NEXT_PUBLIC_STYLE=$NEXT_PUBLIC_STYLE \
	NEXT_PUBLIC_TERTIARY_COLOR=$NEXT_PUBLIC_TERTIARY_COLOR \
	NEXT_PUBLIC_UTM_DURATION=$NEXT_PUBLIC_UTM_DURATION

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN --mount=type=cache,target=/app/.next/cache \
	npm run build

FROM base AS prod-deps

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
	npm install --omit=dev --no-audit --no-fund

FROM ${RUNTIME_IMAGE} AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

WORKDIR /app

RUN groupadd --system --gid 1001 nodejs \
	&& useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=prod-deps --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/docs ./docs
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/next.config.mjs ./next.config.mjs
COPY --from=builder --chown=nextjs:nodejs /app/src/constants/config.json ./src/constants/config.json

USER nextjs

EXPOSE 3000

CMD ["node_modules/.bin/next", "start"]
