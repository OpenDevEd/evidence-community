		"@tailwindcss/typography": "^0.5.15",
		"@types/d3-geo": "^3.1.1",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-zoom": "^3.0.9",
		"@types/geojson": "^7946.0.16",
		"@types/hast": "^3.0.4",
		"@types/node": "^22.20.5",
		"@types/nodemailer": "^7.0.5",
		"@types/pg": "^8.11.10",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/rtl-detect": "^1.0.3",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"citeproc-plus": "2.0.4",
		"esbuild": "^0.27.2",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.5",
		"fallow": "^3.32.0",
		"fast-xml-parser": "^5.11.1",
		"jsdom": "^30.1.2",
		"tailwindcss": "^3.4.1",
