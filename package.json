		"jsdom": "^27.0.0",
		"marked": "^17.0.6",
		"meilisearch": "^0.60.0",
		"next": "^16.2.6",
		"next-auth": "^5.0.0-beta.25",
		"next-intl": "^4.13.4",
		"next-themes": "^0.4.3",
		"node-cache": "^5.1.2",
		"nodemailer": "^7.0.12",
		"nuqs": "^2.3.2",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.2.108",
