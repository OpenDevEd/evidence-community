{
	"name": "evidence-community",
	"version": "0.8.5",
	"private": true,
	"license": "AGPL-3.0-only",
	"scripts": {
		"citations:generate": "node tools/generateCitationAssets.mjs",
		"dev": "next dev --turbopack",
		"build": "npm run schema:generate && FORCE_COLOR=1 NODE_OPTIONS='--max_old_space_size=8192' next build",
		"start": "next start",
		"db:migrate": "drizzle-kit migrate",
		"config:activate": "tsx ./tools/activateLibraryConfig.ts",
		"config:validate": "tsx ./tools/validateLibraryConfig.ts",
		"lint": "eslint .",
		"typecheck": "next typegen && node node_modules/typescript7/bin/tsc --noEmit",
		"quality:fallow": "fallow audit --gate new-only --fail-on-issues --format json --quiet --explain",
		"check": "npm run lint && npm run typecheck && npm run schema:check && npm run check:ai-wording && npm run check:ui-rules && npm run test:unit",
		"verify": "tsx ./tools/verify/cli.ts",
		"check:ai-wording": "tsx ./tools/checkAIWording.ts",
		"check:ui-rules": "tsx ./tools/checkUiRules.ts",
		"check:changed": "npm run check && npm run quality:fallow -- --base origin/main",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:unit": "npm test --",
		"test:acceptance": "tsx ./tools/runRuntimeAcceptance.ts",
		"test:acceptance:cleanup": "tsx ./tools/runRuntimeAcceptance.ts --cleanup",
		"test:library-compose": "tsx ./tools/verifyLibraryCompose.ts",
		"database:provision": "tsx ./tools/provisionLibraryDatabase.ts",
		"database:provisioner": "tsx ./tools/runLibraryDatabaseProvisioner.ts",
		"runtime:verifier": "tsx ./tools/runLibraryRuntimeVerifier.ts",
		"volume:deleter": "tsx ./tools/runLibraryVolumeDeleter.ts",
		"test:database-provisioning": "tsx ./tools/verifyLibraryDatabaseProvisioning.ts",
		"test:source-model": "tsx ./tools/verifySourceModel.ts",
		"test:source-configuration": "tsx ./tools/verifySourceConfiguration.ts",
		"test:publication-model": "tsx ./tools/verifyPublicationModel.ts",
		"test:publication-reconciler": "vitest run --config vitest.integration.config.ts tools/verifyPublicationReconciler.ts",
		"test:publication-worker": "vitest run --config vitest.integration.config.ts tools/verifyPublicationWorker.ts",
		"test:crossref-activation": "vitest run --config vitest.integration.config.ts tools/verifyCrossrefActivation.ts",
		"test:zenodo-activation": "vitest run --config vitest.integration.config.ts tools/verifyZenodoActivation.ts",
		"test:crossref-test-live": "tsx ./tools/verifyCrossrefTestPublication.ts",
		"test:zenodo-sandbox-live": "tsx ./tools/verifyZenodoSandboxPublication.ts",
		"test:publication-sandbox-lifecycle": "tsx ./tools/verifyPublicationSandboxLifecycle.ts",
		"publication:worker:build": "esbuild ./tools/runPublicationWorker.ts --bundle --platform=node --format=esm --conditions=react-server --external:@opentelemetry/api --external:@napi-rs/canvas --external:pdfjs-dist --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=.next/publication/worker.mjs && esbuild ./tools/checkPublicationWorkerHealth.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=.next/publication/health.mjs",
		"publication:worker": "npm run publication:worker:build && node .next/publication/worker.mjs",
		"publication:worker:health": "node .next/publication/health.mjs",
		"test:source-writer": "tsx ./tools/verifySourceIngestionWriter.ts",
		"test:zotero-source": "tsx ./tools/verifyZoteroSourceSync.ts",
		"test:zotero-playground:seed": "tsx ./tools/seedZoteroPlayground.ts",
		"test:zotero-live": "tsx ./tools/verifyLiveZoteroPipeline.ts",
		"test:zotero-writeback-live": "tsx ./tools/verifyLiveZoteroWriteback.ts",
		"test:source-orchestrator": "tsx ./tools/verifySourceOrchestrator.ts",
		"source:sync": "tsx --conditions=react-server ./tools/runSourceSync.ts",
		"pdf:reread-text": "tsx --conditions=react-server ./tools/rereadPdfText.ts",
		"source:writeback": "tsx ./tools/runSourceWriteback.ts",
		"search:index": "tsx ./tools/runSearchIndexer.ts",
		"search:embedder-speed": "tsx ./tools/timeSearchEmbedder.ts",
		"search:index:health": "tsx ./tools/checkSearchIndexerHealth.ts",
		"search:copy-redirects": "tsx ./tools/copyMeilisearchRedirects.ts",
		"search:load-index-only": "tsx --conditions=react-server ./tools/loadIndexOnlyLibrary.ts",
		"search:compare": "tsx --conditions=react-server ./tools/compareSearchEngines.ts",
		"test:search-index": "tsx ./tools/verifySearchOutbox.ts",
		"test:search-embedder": "tsx ./tools/verifyElasticsearchEmbedder.ts",
		"test:search-switch": "tsx --conditions=react-server ./tools/verifySearchEngineSwitch.ts",
		"test:search-worker": "npm run build && tsx ./tools/verifySearchIndexerWorker.ts",
		"test:native-lifecycle": "tsx ./tools/verifyNativeItemLifecycle.ts",
		"test:item-links": "tsx ./tools/verifyItemLinks.ts",
		"test:linked-item-lifecycle": "tsx --conditions=react-server ./tools/verifyLinkedItemDraftLifecycle.ts",
		"test:source-writeback": "tsx ./tools/verifySourceWriteback.ts",
		"test:collection-writeback": "tsx ./tools/verifyCollectionSourceWriteback.ts",
		"test:source-collections": "tsx ./tools/verifySourceCollectionLifecycle.ts",
		"benchmark:admin-items": "tsx ./tools/benchmarkAdminItemList.ts",
		"test:admin-item-pagination": "tsx ./tools/verifyAdminItemListPagination.ts",
		"test:admin-collection-catalog": "tsx ./tools/verifyAdminCollectionCatalog.ts",
		"test:admin-item-projection-concurrency": "tsx ./tools/verifyAdminItemProjectionConcurrency.ts",
		"test:admin-item-batch-http": "tsx ./tools/verifyAdminItemBatchHttp.ts",
		"test:native-collection-lifecycle": "tsx ./tools/verifyNativeCollectionLifecycle.ts",
		"test:native-file-lifecycle": "vitest run --config vitest.integration.config.ts tools/verifyNativeFileLifecycle.ts tests/integration/editorial-reviews.test.ts",
		"test:file-storage": "tsx ./tools/verifySupabaseFileStorage.ts",
		"test:native-file-http": "tsx ./tools/verifyNativeFileHttp.ts",
		"icons:generate": "tsx ./tools/generateHugeiconSprites.ts",
		"icons:check": "tsx ./tools/generateHugeiconSprites.ts --check",
		"schema:generate": "npm run schema:generate:library-config && npm run schema:generate:zotero",
		"schema:generate:library-config": "tsx ./tools/generateLibraryConfigArtifacts.ts",
		"schema:generate:zotero": "tsx ./tools/generateZoteroSchema.ts",
		"schema:check": "tsx ./tools/generateLibraryConfigArtifacts.ts --check && tsx ./tools/generateZoteroSchema.ts --check && npm run icons:check",
		"test:admin-zotero-live": "tsx ./tools/verifyAdminZoteroWriteback.ts",
		"postinstall": "patch-package"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.80",
		"@ai-sdk/deepseek": "^3.0.65",
		"@ai-sdk/google": "^4.0.96",
		"@ai-sdk/mistral": "^4.0.64",
