		"react": "^19.2.4",
		"react-aria": "^3.52.1",
		"react-aria-components": "^1.21.1",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "^19.2.4",
		"react-markdown": "^9.0.1",
		"recharts": "^2.15.4",
		"redis": "^6.2.1",
		"remark-gfm": "^4.0.0",
		"rtl-detect": "^1.1.2",
		"server-only": "^0.0.1",
		"sharp": "^0.33.5",
