		"@uidotdev/usehooks": "^2.4.1",
		"@vercel/functions": "^3.6.2",
		"ai": "^7.0.73",
		"babel-plugin-react-compiler": "^1.0.0",
		"balanced-match": "^3.0.1",
		"bcrypt": "^5.1.1",
		"chart.js": "^4.5.1",
		"citation-js": "^0.7.16",
		"citeproc": "^2.4.63",
		"d3-color": "^3.1.0",
		"d3-interpolate": "^3.0.1",
		"d3-transition": "^3.0.1",
