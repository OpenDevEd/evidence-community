		"@tailwindcss/typography": "^0.5.15",
		"@types/balanced-match": "^3.0.2",
		"@types/bcrypt": "^5.0.2",
		"@types/node": "^20",
		"@types/nodemailer": "^7.0.5",
		"@types/pg": "^8.11.10",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/react-simple-maps": "^3.0.6",
		"@types/rtl-detect": "^1.0.3",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"esbuild": "^0.27.2",
		"eslint": "^9.39.1",
		"eslint-config-next": "^16.2.6",
		"fallow": "3.17.0",
		"fast-xml-parser": "^5.11.1",
		"tailwindcss": "^3.4.1",
		"typescript": "^5",
		"vitest": "^4.1.10"
	},
	"prettier": {
		"useTabs": true,
		"tabWidth": 4
	},
	"overrides": {
		"@types/react": "$@types/react",
		"@types/react-dom": "$@types/react-dom",
		"usehooks-ts": {
			"react": "^19"
		},
		"next-auth": {
			"next": "$next"
		},
		"next-intl": {
			"next": "$next"
		},
		"nuqs": {
			"next": "$next"
		},
		"react-simple-maps": {
			"react": "^19",
			"react-dom": "^19",
			"d3-color": "^3.1.0",
			"d3-interpolate": "^3.0.1",
			"d3-transition": "^3.0.1",
			"d3-zoom": "^3.0.0"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.27.2"
		},
		"postcss": "^8.5.26",
		"@parcel/watcher": {
			"picomatch": "^4.0.4"
		}
	}
