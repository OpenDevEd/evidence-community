		"@nextui-org/shared-icons": "^2.1.1",
		"@opendeved/doi-sync-core": "github:OpenDevEd/doi-sync-core#df6f013294973922cbfa3e51168b328426093ceb",
		"@opendeved/evidence-library-core": "file:packages/evidence-library-core",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-hover-card": "^1.1.23",
		"@radix-ui/react-navigation-menu": "^1.4.1",
		"@supabase/supabase-js": "^2.118.0",
		"@tanstack/react-form": "^1.6.3",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.14.9",
		"@tiptap/extension-link": "^3.31.4",
		"@tiptap/markdown": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/react": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"@uidotdev/usehooks": "^2.4.1",
		"@vercel/functions": "^3.6.2",
		"ai": "^7.0.141",
		"babel-plugin-react-compiler": "^1.0.0",
		"better-auth": "^1.7.7",
		"chart.js": "^4.5.1",
		"citeproc-ts": "0.2.5",
